
class Solution {
    public int climbStairs(int n, int[] costs) {

        long[] dp = new long[n + 1];

        dp[0] = 0;

        for (int i = 1; i <= n; i++) {

            dp[i] = Long.MAX_VALUE;

            // We can jump 1, 2, or 3 steps
            for (int jump = 1; jump <= 3; jump++) {

                if (i - jump >= 0) {

                    long cost = dp[i - jump]
                              + costs[i - 1]
                              + (long) jump * jump;

                    dp[i] = Math.min(dp[i], cost);
                }
            }
        }

        return (int) dp[n];
    }
}
