import java.util.*;

class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        int[][] cost = new int[n][n];

        // cost[i][j] = min changes to make s[i..j] a semi-palindrome
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int len = j - i + 1;
                int best = Integer.MAX_VALUE;
                for (int d = 1; d < len; d++) {
                    if (len % d != 0) continue;
                    int c = 0;
                    for (int g = 0; g < d; g++) {
                        int l = i + g;
                        int r = i + g + ((len / d) - 1) * d;
                        while (l < r) {
                            if (s.charAt(l) != s.charAt(r)) c++;
                            l += d;
                            r -= d;
                        }
                    }
                    best = Math.min(best, c);
                }
                cost[i][j] = best;
            }
        }

        final int INF = 1_000_000;
        // dp[p][i] = min cost to split first i chars into p parts
        int[][] dp = new int[k + 1][n + 1];
        for (int[] row : dp) Arrays.fill(row, INF);
        dp[0][0] = 0;

        for (int p = 1; p <= k; p++) {
            for (int i = 2 * p; i <= n; i++) {
                for (int j = 2 * (p - 1); j + 2 <= i; j++) {
                    if (dp[p - 1][j] >= INF) continue;
                    // last part is s[j..i-1], length >= 2
                    dp[p][i] = Math.min(dp[p][i], dp[p - 1][j] + cost[j][i - 1]);
                }
            }
        }
        return dp[k][n];
    }
}