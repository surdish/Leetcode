
import java.util.*;

class Solution {

    class Fenwick {
        int n;
        long[] count;
        long[] sum;

        Fenwick(int n) {
            this.n = n;
            count = new long[n + 1];
            sum = new long[n + 1];
        }

        void update(int i, long c, long s) {
            while (i <= n) {
                count[i] += c;
                sum[i] += s;
                i += i & -i;
            }
        }

        long queryCount(int i) {
            long result = 0;
            while (i > 0) {
                result += count[i];
                i -= i & -i;
            }
            return result;
        }

        long querySum(int i) {
            long result = 0;
            while (i > 0) {
                result += sum[i];
                i -= i & -i;
            }
            return result;
        }

        int findKth(int k) {
            int pos = 0;

            for (int bit = Integer.highestOneBit(n);
                 bit > 0; bit >>= 1) {

                int next = pos + bit;

                if (next <= n && count[next] < k) {
                    pos = next;
                    k -= (int) count[next];
                }
            }

            return pos + 1;
        }
    }

    public long minOperations(int[] nums, int x, int k) {

        int n = nums.length;

        // Coordinate compression
        int[] sorted = nums.clone();
        Arrays.sort(sorted);

        int size = 0;

        for (int v : sorted) {
            if (size == 0 || sorted[size - 1] != v) {
                sorted[size++] = v;
            }
        }

        int[] values = Arrays.copyOf(sorted, size);

        Fenwick bit = new Fenwick(size);

        // Add first window
        for (int i = 0; i < x; i++) {
            int id = Arrays.binarySearch(values, nums[i]) + 1;
            bit.update(id, 1, nums[i]);
        }

        long[] cost = new long[n - x + 1];

        // Calculate cost of first window
        cost[0] = getCost(bit, values, x);

        // Sliding window
        for (int i = x; i < n; i++) {

            int removeId =
                Arrays.binarySearch(values, nums[i - x]) + 1;

            bit.update(removeId, -1, -((long) nums[i - x]));

            int addId =
                Arrays.binarySearch(values, nums[i]) + 1;

            bit.update(addId, 1, nums[i]);

            cost[i - x + 1] = getCost(bit, values, x);
        }

        // Dynamic Programming
        long INF = Long.MAX_VALUE / 4;

        long[][] dp = new long[k + 1][n + 1];

        for (int i = 0; i <= k; i++) {
            Arrays.fill(dp[i], INF);
        }

        // Zero subarrays require zero operations
        for (int i = 0; i <= n; i++) {
            dp[0][i] = 0;
        }

        for (int j = 1; j <= k; j++) {

            for (int i = 1; i <= n; i++) {

                // Option 1: Skip current element
                dp[j][i] = dp[j][i - 1];

                // Option 2: Select a window of length x
                if (i >= x && dp[j - 1][i - x] != INF) {

                    long take =
                        dp[j - 1][i - x] + cost[i - x];

                    dp[j][i] = Math.min(dp[j][i], take);
                }
            }
        }

        return dp[k][n];
    }

    private long getCost(Fenwick bit, int[] values, int x) {

        // Find median (lower median for even-sized windows)
        int medianIndex = bit.findKth((x + 1) / 2);

        long median = values[medianIndex - 1];

        long leftCount = bit.queryCount(medianIndex);
        long leftSum = bit.querySum(medianIndex);

        long totalSum = bit.querySum(values.length);

        long rightCount = x - leftCount;
        long rightSum = totalSum - leftSum;

        return median * leftCount - leftSum
             + rightSum - median * rightCount;
    }
}
