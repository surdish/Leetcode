
import java.util.*;

class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        long operations = (long) k1 + k2;
        long maxDiff = 0;
        long sum = 0;

        int n = nums1.length;
        long[] diff = new long[n];

        for (int i = 0; i < n; i++) {
            diff[i] = Math.abs((long) nums1[i] - nums2[i]);
            maxDiff = Math.max(maxDiff, diff[i]);
            sum += diff[i];
        }

        if (sum <= operations) {
            return 0;
        }

        long left = 0, right = maxDiff;

        while (left < right) {
            long mid = left + (right - left) / 2;

            long needed = 0;
            for (long d : diff) {
                if (d > mid) {
                    needed += d - mid;
                }
            }

            if (needed <= operations) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }

        long level = left;
        long used = 0;
        long answer = 0;

        for (long d : diff) {
            if (d > level) {
                used += d - level;
                answer += level * level;
            } else {
                answer += d * d;
            }
        }

        long remaining = operations - used;

        for (long d : diff) {
            if (remaining == 0) {
                break;
            }

            if (d >= level && level > 0) {
                answer -= level * level;
                answer += (level - 1) * (level - 1);
                remaining--;
            }
        }

        return answer;
    }
}
