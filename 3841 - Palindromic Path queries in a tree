import java.util.*;

class Solution {
    int n;
    int[] bit;

    void upd(int i, int v) {
        for (; i <= n; i += i & -i) bit[i] ^= v;
    }

    int qry(int i) {
        int r = 0;
        for (; i > 0; i -= i & -i) r ^= bit[i];
        return r;
    }

    public List<Boolean> palindromePath(int n, int[][] edges, String s, String[] queries) {
        this.n = n;
        bit = new int[n + 2];
        char[] cs = s.toCharArray();

        int[] head = new int[n], nxt = new int[2 * (n - 1)], to = new int[2 * (n - 1)];
        Arrays.fill(head, -1);
        int cnt = 0;
        for (int[] e : edges) {
            to[cnt] = e[1]; nxt[cnt] = head[e[0]]; head[e[0]] = cnt++;
            to[cnt] = e[0]; nxt[cnt] = head[e[1]]; head[e[1]] = cnt++;
        }

        int LOG = 17;
        int[][] up = new int[LOG][n];
        int[] par = new int[n], depth = new int[n];
        int[] tin = new int[n], tout = new int[n], base = new int[n];
        int[] it = head.clone();
        int[] st = new int[n];
        int sp = 0, timer = 1;

        par[0] = -1;
        up[0][0] = 0;
        tin[0] = timer++;
        base[0] = 1 << (cs[0] - 'a');
        st[sp++] = 0;
        while (sp > 0) {
            int v = st[sp - 1];
            int e = it[v];
            if (e != -1) {
                it[v] = nxt[e];
                int w = to[e];
                if (w == par[v]) continue;
                par[w] = v;
                up[0][w] = v;
                depth[w] = depth[v] + 1;
                base[w] = base[v] ^ (1 << (cs[w] - 'a'));
                tin[w] = timer++;
                st[sp++] = w;
            } else {
                tout[v] = timer - 1;
                sp--;
            }
        }

        for (int j = 1; j < LOG; j++)
            for (int v = 0; v < n; v++)
                up[j][v] = up[j - 1][up[j - 1][v]];

        List<Boolean> ans = new ArrayList<>();
        for (String q : queries) {
            String[] p = q.split(" ");
            if (p[0].equals("update")) {
                int u = Integer.parseInt(p[1]);
                char c = p[2].charAt(0);
                if (cs[u] != c) {
                    int delta = (1 << (cs[u] - 'a')) ^ (1 << (c - 'a'));
                    cs[u] = c;
                    upd(tin[u], delta);
                    if (tout[u] + 1 <= n) upd(tout[u] + 1, delta);
                }
            } else {
                int u = Integer.parseInt(p[1]);
                int v = Integer.parseInt(p[2]);
                // LCA
                int a = u, b = v;
                if (depth[a] < depth[b]) { int t = a; a = b; b = t; }
                int diff = depth[a] - depth[b];
                for (int j = 0; j < LOG; j++)
                    if ((diff >> j & 1) == 1) a = up[j][a];
                if (a != b) {
                    for (int j = LOG - 1; j >= 0; j--) {
                        if (up[j][a] != up[j][b]) {
                            a = up[j][a];
                            b = up[j][b];
                        }
                    }
                    a = up[0][a];
                }
                int lca = a;
                int pu = base[u] ^ qry(tin[u]);
                int pv = base[v] ^ qry(tin[v]);
                int mask = pu ^ pv ^ (1 << (cs[lca] - 'a'));
                ans.add((mask & (mask - 1)) == 0);
            }
        }
        return ans;
    }
}